        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Fetch API Retry Wrapper\",\n  \"language\": \"JavaScript\",\n  \"category\": \"Frontend & DOM\",\n  \"tags\": \"fetch,async,retry,error-handling\",\n  \"description\": \"Automatic exponential backoff retry wrapper for window.fetch requests.\",\n  \"codeContent\": \"async function fetchWithRetry(url, options = {}, retries = 3) {\\n  try {\\n    const res = await fetch(url, options);\\n    if (!res.ok) throw new Error(res.statusText);\\n    return await res.json();\\n  } catch (err) {\\n    if (retries <= 0) throw err;\\n    await new Promise(r => setTimeout(r, 1000));\\n    return fetchWithRetry(url, options, retries - 1);\\n  }\\n}\",\n  \"author\": \"Karthik Rao\",\n  \"favorite\": true,\n  \"sharedWithTeam\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/snippets",
          "host": ["{{baseUrl}}"],
          "path": ["api", "snippets"]
        }
      }
    },
